# Runtime. Supply actual values with Secret Manager or your deployment environment.
NODE_ENV=production
PORT=8080
DATABASE_URL="postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST/REPLACE_DATABASE"
APP_ORIGIN="https://REPLACE_SERVICE_HOST"
SESSION_CSRF_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
SESSION_TTL_HOURS=12
# Separate bootstrap command only. Supply a reviewed manifest as a secret.
# Existing passwords are preserved. No demo defaults are used.
BOOTSTRAP_INPUT='{"users":[{"username":"REPLACE_CUSTODIAN","password":"REPLACE_WITH_RANDOM_PASSWORD","role":"CUSTODIAN"}],"assets":[{"assetId":"REPLACE_ASSET_ID","name":"REPLACE_ASSET_NAME","category":"REPLACE_CATEGORY","description":"REPLACE_DESCRIPTION","custodianUsername":"REPLACE_CUSTODIAN"}]}'
