# PostgreSQL connection string for persistent application data. Replace every credential.
DATABASE_URL="postgresql://kitloop_user:replace-me@localhost:5432/kitloop?schema=public"
# Exact browser origin allowed to send authenticated requests.
APP_ORIGIN="http://localhost:5173"
# Generate a unique random value of at least 32 characters; keep it server-side.
SESSION_CSRF_SECRET="replace-with-a-long-random-secret"
# Session lifetime in hours. Optional; defaults to 12.
SESSION_TTL_HOURS="12"
# HTTP port. Cloud Run sets PORT at runtime.
PORT="3000"
# Local demo seed only. The demo seed refuses to run with NODE_ENV=production.
DEMO_BORROWER_PASSWORD="replace-for-local-demo"
DEMO_CUSTODIAN_PASSWORD="replace-for-local-demo"
