# Copy to .env and replace every REPLACE_* value. Never commit .env.
POSTGRES_USER=REPLACE_DB_USER
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_PASSWORD
POSTGRES_DB=REPLACE_DB_NAME
# Credentials/database must match the three values above. Keep db:5432 as the host.
DATABASE_URL=postgresql://REPLACE_DB_USER:REPLACE_WITH_URL_SAFE_RANDOM_PASSWORD@db:5432/REPLACE_DB_NAME?schema=public
SESSION_CSRF_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SESSION_TTL_HOURS=12
APP_ORIGIN=http://localhost:8080
WEB_PORT=8080
DEMO_BORROWER_PASSWORD=REPLACE_WITH_LOCAL_BORROWER_PASSWORD
DEMO_CUSTODIAN_PASSWORD=REPLACE_WITH_LOCAL_CUSTODIAN_PASSWORD
